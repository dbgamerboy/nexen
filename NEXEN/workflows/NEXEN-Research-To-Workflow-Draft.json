{
  "name": "NEXEN - Research to Workflow Draft (rules-checked)",
  "active": false,
  "nodes": [
    {
      "parameters": { "httpMethod": "POST", "path": "research-draft", "responseMode": "responseNode", "options": {} },
      "id": "r1",
      "name": "Research note in",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [220, 300],
      "webhookId": "nexen-research-draft"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://127.0.0.1:8794/api/n8n/marvin",
        "sendHeaders": true,
        "headerParameters": { "parameters": [{ "name": "X-Nexen-Action", "value": "v4" }, { "name": "Content-Type", "value": "application/json" }] },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ op: 'draft_workflow', text: $json.body.text, source_ids: $json.body.source_ids || [], platform: $json.body.platform || 'tiktok', account: $json.body.account || null }) }}",
        "options": { "timeout": 120000 }
      },
      "id": "r2",
      "name": "Draft under the rules",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [480, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [{ "id": "q1", "leftValue": "={{ $json.result.verdict.status }}", "rightValue": "blocked", "operator": { "type": "string", "operation": "equals" } }],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "r3",
      "name": "Would it break a rule?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [740, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ status: 'rewritten by the rules', rewritten_as: $json.result.rewritten_as, why: $json.result.why, draft: $json.result.id }) }}",
        "options": {}
      },
      "id": "r4",
      "name": "Reply: rewritten as a lawful alternative",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1000, 220]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ status: 'draft saved inactive; owner approval needed to publish', draft: $json.result.id, gates: $json.result.gates }) }}",
        "options": {}
      },
      "id": "r5",
      "name": "Reply: draft saved inactive",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1000, 400]
    }
  ],
  "connections": {
    "Research note in": { "main": [[{ "node": "Draft under the rules", "type": "main", "index": 0 }]] },
    "Draft under the rules": { "main": [[{ "node": "Would it break a rule?", "type": "main", "index": 0 }]] },
    "Would it break a rule?": { "main": [[{ "node": "Reply: rewritten as a lawful alternative", "type": "main", "index": 0 }], [{ "node": "Reply: draft saved inactive", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" },
  "meta": { "note": "POST {\"text\":\"research note\",\"source_ids\":[\"url:youtube:ID\"],\"platform\":\"tiktok\",\"account\":\"B\"}. Nothing is posted; the draft is saved inactive." }
}
